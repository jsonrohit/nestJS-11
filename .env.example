# Application
PORT=8888

# Database — update to match your MySQL credentials
DATABASE_URL="mysql://nestuser:nestpass@localhost:3306/nestjs"

# For docker-compose, these are used to build DATABASE_URL automatically
DB_ROOT_PASSWORD=rootpass
DB_NAME=nestjs
DB_USER=nestuser
DB_PASSWORD=nestpass

# JWT
JWT_SECRET="replace-with-a-strong-secret"
JWT_EXPIRATION="3600s"

# Used by CD pipeline (set in GitHub / CI secrets, not here)
APP_PORT=8888
